{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "portfolio/v1",
  "description": "A persisted chain-of-models portfolio: member threat-model runs plus declared typed relationships between their real recon elements. Membership + declared edges are stored; aggregates and taxonomy overlaps are derived at build time and never persisted. Additive — references runs, changes no existing manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "name", "members"],
  "properties": {
    "schema": {"type": "string", "enum": ["portfolio/v1"]},
    "id": {"type": "string"},
    "name": {"type": "string"},
    "description": {"type": "string"},
    "version": {"type": "string"},
    "members": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["run_id", "path"],
        "properties": {
          "run_id": {"type": "string", "description": "stable, unique within the portfolio; the pivot key"},
          "label": {"type": "string"},
          "path": {"type": "string", "description": "locator for the run's canonical manifests"},
          "content_hash": {"type": "string", "description": "optional sha256 pin of the member manifests"}
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "type", "origin", "source", "target", "provenance"],
        "properties": {
          "id": {"type": "string"},
          "type": {
            "type": "string",
            "enum": ["shared_component", "shared_datastore", "shared_dependency", "upstream_trust",
                     "downstream_trust", "shared_risk", "shared_killchain", "common_control"]
          },
          "origin": {"type": "string", "enum": ["declared"],
                     "description": "only declared edges are persisted; derived links are computed, not stored"},
          "source": {"$ref": "#/definitions/endpoint"},
          "target": {"$ref": "#/definitions/endpoint"},
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["asserted_by", "at", "rationale"],
            "properties": {
              "asserted_by": {"type": "string"},
              "at": {"type": "string"},
              "rationale": {"type": "string"}
            }
          }
        }
      }
    }
  },
  "definitions": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run", "element"],
      "properties": {
        "run": {"type": "string", "description": "a member run_id"},
        "element": {"type": "string", "description": "a real recon element id in that run (C*/D*/E*/X*/R*/TB*)"}
      }
    }
  }
}
