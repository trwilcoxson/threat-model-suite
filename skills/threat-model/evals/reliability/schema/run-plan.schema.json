{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "run-plan/v1",
  "description": "The deterministic, user-confirmed selection fact written at the top of a run: exactly which mode, which specialist agents, and which output artifacts the run will produce. Additive — no existing manifest changes.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "mode", "team", "outputs", "confirmed"],
  "properties": {
    "schema": {"type": "string", "enum": ["run-plan/v1"]},
    "mode": {"type": "string", "enum": ["solo", "team"]},
    "team": {
      "type": "array",
      "items": {"type": "string", "enum": ["privacy", "grc", "code-review"]}
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["report.html", "report.docx", "report.pdf", "executive-summary.pptx", "dashboard", "analytical-visuals"]
      }
    },
    "confirmed": {"type": "boolean"},
    "source": {"type": "string", "enum": ["one-shot", "menu"]},
    "chain": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["portfolio_id", "run_id", "portfolio_path"],
      "description": "Optional portfolio-chain membership. Absent or null => standalone (default). When present, all three fields are required; the run is upserted into portfolio_path keyed by run_id after the pipeline completes.",
      "properties": {
        "portfolio_id": {"type": "string"},
        "run_id": {"type": "string"},
        "portfolio_path": {"type": "string"}
      }
    }
  }
}
