## D2 re-render of the ECS-fullstack structural threat-model diagram (L1)
## Typed icons per node type + styled trust-boundary containers.
## Render: curl -X POST https://kroki.io/d2/svg --data-binary @structural.d2
## (icons fetched server-side by Kroki; for offline prod, vendor SVGs as local paths.)

vars: {
  d2-config: {
    layout-engine: elk
    theme-id: 4
  }
}

classes: {
  actor:     { shape: person;   style: { fill: "#cce5ff"; stroke: "#004085" } }
  extdep:    { shape: package;   style: { fill: "#f5f5f5"; stroke: "#333333"; stroke-dash: 3; stroke-width: 2 } }
  svc:       { style: { fill: "#f5f5f5"; stroke: "#666666" } }
  store:     { shape: cylinder;  style: { fill: "#e2e3e5"; stroke: "#383d41" } }
  pipe:      { style: { fill: "#d5dbdb"; stroke: "#7f8c8d" } }
  queue:     { shape: queue;     style: { fill: "#d5dbdb"; stroke: "#7f8c8d" } }
}

# ---- external actors & dependencies (outside all trust boundaries) ----
R0: "Anonymous Internet User\n(browser · no credential)" { class: actor }
R5: "Terraform Operator / Developer\n(AWS creds + GitHub PAT)" { class: actor }
X1: "GitHub Repository\n[vendor:GitHub] source + PAT" {
  class: extdep
  icon: https://icons.terrastruct.com/dev%2Fgithub.svg
}
X4: "Docker Base Images\nbitnami/node, nginx :latest\n[vendor:public-ECR]" {
  class: extdep
  icon: https://icons.terrastruct.com/dev%2Fdocker.svg
}

# ---- TRUST BOUNDARY: VPC ----
VPC: "VPC 10.120.0.0/16 · AWS Account · 2 AZ" {
  icon: https://icons.terrastruct.com/aws%2FNetworking%20%26%20Content%20Delivery%2FAmazon-VPC.svg
  style: { fill: "#eaf2fb"; stroke: "#004085"; stroke-dash: 4; stroke-width: 2; border-radius: 8 }

  PUB: "Public Subnets — ALB tier" {
    style: { fill: "#f4f9ff"; stroke: "#3b6ea5"; stroke-dash: 2 }
    C4: "Client ALB\ninternet-facing · HTTP:80 [managed]" {
      class: svc
      icon: https://icons.terrastruct.com/aws%2FNetworking%20%26%20Content%20Delivery%2FElastic-Load-Balancing.svg
    }
    C5: "Server / API ALB\ninternet-facing · HTTP:80 [managed]" {
      class: svc
      icon: https://icons.terrastruct.com/aws%2FNetworking%20%26%20Content%20Delivery%2FElastic-Load-Balancing.svg
    }
  }

  PRIV: "Private Subnets — ECS Fargate task tier" {
    style: { fill: "#fff8f0"; stroke: "#a5713b"; stroke-dash: 2 }
    C6: "ECS Cluster (Fargate) [managed]" {
      class: svc
      icon: https://icons.terrastruct.com/aws%2FCompute%2FAmazon-Elastic-Container-Service.svg
    }
    C7: "ECS Service — client task [managed]" {
      class: svc
      icon: https://icons.terrastruct.com/aws%2FCompute%2FAmazon-Elastic-Container-Service.svg
    }
    C8: "ECS Service — server task [managed]" {
      class: svc
      icon: https://icons.terrastruct.com/aws%2FCompute%2FAmazon-Elastic-Container-Service.svg
    }
    C1: "Client SPA\nVue.js 2 · Nginx [self-managed]" { class: svc }
    C2: "Server API\nNode.js · Express 4 [self-managed]" {
      class: svc
      icon: https://icons.terrastruct.com/dev%2Fnodejs.svg
    }
    C3: "Swagger / API Docs\n/api/docs [self-managed]" { class: svc }
  }
}

# ---- TRUST BOUNDARY: CI/CD control plane ----
CICD: "CI/CD Control Plane" {
  style: { fill: "#f3f0fb"; stroke: "#6f42c1"; stroke-dash: 4; stroke-width: 2; border-radius: 8 }
  C9: "CodePipeline\nSource/Build/Deploy [managed]" {
    class: pipe
    icon: https://icons.terrastruct.com/aws%2FDeveloper%20Tools%2FAWS-CodePipeline.svg
  }
  C10: "CodeBuild\nstandard:4.0 · privileged [managed]" {
    class: pipe
    icon: https://icons.terrastruct.com/aws%2FDeveloper%20Tools%2FAWS-CodeBuild.svg
  }
  C11: "CodeDeploy\nblue/green ECS [managed]" {
    class: pipe
    icon: https://icons.terrastruct.com/aws%2FDeveloper%20Tools%2FAWS-CodeDeploy.svg
  }
  C12: "ECS Autoscaling + CloudWatch [managed]" {
    class: svc
    icon: https://icons.terrastruct.com/aws%2FManagement%20%26%20Governance%2FAmazon-CloudWatch.svg
  }
  C13: "SNS Topic\ndeployment notifications [managed]" {
    class: queue
    icon: https://icons.terrastruct.com/aws%2FApplication%20Integration%2FAmazon-Simple-Notification-Service-SNS.svg
  }
}

# ---- data stores (AWS-managed, outside compute boundaries) ----
D1: "DynamoDB\nproduct catalog [managed]" {
  class: store
  icon: https://icons.terrastruct.com/aws%2FDatabase%2FAmazon-DynamoDB.svg
}
D2: "S3 assets bucket\nproduct images [managed]" {
  class: store
  icon: https://icons.terrastruct.com/aws%2FStorage%2FAmazon-Simple-Storage-Service-S3.svg
}
D3: "S3 artifact bucket\nsource + build artifacts [managed]" {
  class: store
  icon: https://icons.terrastruct.com/aws%2FStorage%2FAmazon-Simple-Storage-Service-S3.svg
}
D4: "ECR repositories\nserver + client · MUTABLE [managed]" {
  class: store
  icon: https://icons.terrastruct.com/aws%2FCompute%2FAmazon-EC2-Container-Registry.svg
}
D5: "CloudWatch Logs\n30-day retention [managed]" {
  class: store
  icon: https://icons.terrastruct.com/aws%2FManagement%20%26%20Governance%2FAmazon-CloudWatch.svg
}
D6: "Terraform State\nlocal file · contains github_token [self-managed]" { class: store }

# ---- edges (typed: label carries protocol · sensitivity · [ENC|PLAIN]) ----
R0 -> VPC.PUB.C4: "HTTP · SPA page load [PUBLIC] [PLAIN]"
VPC.PUB.C4 -> VPC.PRIV.C7: "HTTP · fwd to client task [INTERNAL] [PLAIN]"
VPC.PRIV.C7 -> VPC.PRIV.C1: "[CTRL] ECS runs SPA container" { style.stroke-dash: 3 }
R0 -> VPC.PUB.C5: "HTTP · GET /api/getAllProducts [PUBLIC] [PLAIN]"
VPC.PUB.C5 -> VPC.PRIV.C8: "HTTP · fwd to server task [INTERNAL] [PLAIN]"
VPC.PRIV.C8 -> VPC.PRIV.C2: "[CTRL] ECS runs API container" { style.stroke-dash: 3 }
VPC.PRIV.C2 -> VPC.PRIV.C3: "[CTRL] serves /api/docs [PUBLIC]" { style.stroke-dash: 3 }
VPC.PRIV.C2 -> D1: "HTTPS · DocumentClient.scan [INTERNAL]"
R0 -> D2: "HTTPS · product image fetch [INTERNAL]"
VPC.PRIV.C7 -> D5: "awslogs task logs [INTERNAL]"
VPC.PRIV.C8 -> D5: "awslogs task logs [INTERNAL]"
R5 -> X1: "[BUILD] git push to main [INTERNAL]" { style.stroke: "#f39c12"; style.stroke-width: 2 }
R5 -> D6: "[ADMIN] terraform apply · local state [RESTRICTED]" { style: { stroke: "#cc0000"; stroke-width: 2; stroke-dash: 3 } }
X1 -> CICD.C9: "[BUILD] source poll [CONFIDENTIAL]" { style: { stroke: "#f39c12"; stroke-width: 2 } }
CICD.C9 -> D3: "[BUILD] store source + artifacts [CONFIDENTIAL]" { style: { stroke: "#f39c12"; stroke-width: 2 } }
CICD.C9 -> CICD.C10: "[BUILD] trigger build [INTERNAL]" { style: { stroke: "#f39c12"; stroke-width: 2 } }
X4 -> CICD.C10: "[BUILD] pull base image :latest [INTERNAL]" { style: { stroke: "#f39c12"; stroke-width: 2 } }
CICD.C10 -> D4: "[BUILD] docker build/push [CONFIDENTIAL]" { style: { stroke: "#f39c12"; stroke-width: 2 } }
CICD.C10 -> D5: "[BUILD] build logs [INTERNAL]" { style: { stroke: "#f39c12"; stroke-width: 2 } }
CICD.C9 -> CICD.C11: "[BUILD] trigger deploy [INTERNAL]" { style: { stroke: "#f39c12"; stroke-width: 2 } }
CICD.C11 -> VPC.PRIV.C6: "[CTRL] blue/green deploy [INTERNAL]" { style.stroke-dash: 3 }
D4 -> VPC.PRIV.C6: "[CTRL] image pull on task start [INTERNAL]" { style.stroke-dash: 3 }
VPC.PRIV.C6 -> VPC.PRIV.C7: "[CTRL] schedule client tasks" { style.stroke-dash: 3 }
VPC.PRIV.C6 -> VPC.PRIV.C8: "[CTRL] schedule server tasks" { style.stroke-dash: 3 }
CICD.C11 -> CICD.C13: "[ASYNC] deploy notifications [INTERNAL]" { style: { stroke: "#27ae60"; stroke-width: 2 } }
CICD.C12 -> VPC.PRIV.C8: "[CTRL] autoscaling CPU/mem [INTERNAL]" { style.stroke-dash: 3 }
