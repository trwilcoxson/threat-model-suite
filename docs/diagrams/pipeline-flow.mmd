%%{init: {"theme": "base", "themeVariables": {"primaryColor": "#f5f5f5", "primaryTextColor": "#1a1a2e", "primaryBorderColor": "#555", "lineColor": "#4a4a6a", "secondaryColor": "#e8eaf6", "fontSize": "15px", "fontFamily": "'Segoe UI', 'Helvetica Neue', Arial, sans-serif", "edgeLabelBackground": "#ffffffee", "clusterBkg": "#f8f9fa", "clusterBorder": "#dee2e6"}, "flowchart": {"useMaxWidth": false, "htmlLabels": true, "curve": "basis", "padding": 24, "nodeSpacing": 50, "rankSpacing": 60}}}%%

%% PNG regen needs mmdc / Chromium (env-blocked here) — a maintainer must regenerate pipeline-flow.png after editing this source.
flowchart TD
    Start(["User Request"]) --> Step0["<b>Step 0 — run selection</b><br/>menu: mode · team · outputs · chain <i>(opt-in)</i><br/><i>STOP for user pick</i> → run-plan.json"]
    Step0 --> Plan{"START gate<br/><i>run-plan.json confirmed?</i>"}
    Plan -->|"deny → show menu"| Step0
    Plan -->|"pass"| Recon["Parent does lightweight recon<br/><i>Glob/Grep for IaC, APIs, data stores</i>"]
    Recon --> Mode{"Solo or Team?"}

    %% ---------- Solo Path ----------
    Mode -->|"Small system,<br/>no sensitive data,<br/>no IaC"| Solo_SA1["<b>security-architect</b><br/><i>blocking</i><br/>Phase 1 — reconnaissance"]
    Solo_SA1 -->|"01-reconnaissance.md<br/>recon.json + coverage seed"| Solo_DS1["<b>diagram-specialist</b><br/><i>blocking</i><br/>Phase 2 — structural DFDs"]
    Solo_DS1 -->|"02-structural-diagram.md"| Solo_SA2["<b>security-architect</b><br/><i>blocking</i><br/>Phases 3-5 — generative analysis"]
    Solo_SA2 -->|"03-05.md"| Solo_SAV["<b>security-architect</b><br/><i>blocking · FRESH context</i><br/>Phases 6 + 8 — skeptical validation<br/><i>reads generative output from disk</i>"]
    Solo_SAV -->|"06.md, 08.md, findings.json"| Solo_DS2["<b>diagram-specialist</b><br/><i>blocking</i><br/>Phase 7 — risk overlay<br/>+ analytical visuals"]
    Solo_DS2 -->|"07-final-diagram.md"| Solo_Gate{"Manifest Validation Gate<br/><i>deterministic</i>"}
    Solo_Gate -->|"pass"| Solo_RA["<b>report-analyst</b><br/><i>blocking</i><br/>QA + Generate 4 formats"]
    Solo_RA --> Solo_Done(["Solo Complete<br/><b>report.html, .docx, .pdf, .pptx</b>"])
    Solo_RA -.->|"if dashboard ∈ run-plan.outputs"| Dash["<b>dashboard.html</b><br/><i>Phase 8 · opt-in</i><br/>offline analytics + run's own diagram"]

    %% ---------- Team Path ----------
    Mode -->|"Complex system,<br/>PII/PHI, cloud IaC,<br/>compliance needs"| Team_SA1["<b>security-architect</b><br/><i>blocking</i><br/>Phase 1 — reconnaissance"]
    Team_SA1 -->|"01-reconnaissance.md<br/>recon.json + coverage seed"| Team_DS1["<b>diagram-specialist</b><br/><i>blocking</i><br/>Phase 2 — structural DFDs"]

    %% Specialists fan out at the Phase-2 frontier and run concurrently with Phases 3-7
    Team_DS1 -->|"02-structural-diagram.md<br/><i>(node-id namespace)</i>"| Fork["Parent fans out the 3 specialists<br/>in <b>background</b><br/><i>concurrent with Phases 3-7</i>"]
    Team_DS1 --> Team_SA2["<b>security-architect</b><br/><i>blocking</i><br/>Phases 3-5 — generative analysis"]

    Fork --> PA["<b>privacy-agent</b><br/><i>background</i><br/>LINDDUN + regulatory"]
    Fork --> GRC["<b>grc-agent</b><br/><i>background</i><br/>Cross-framework mapping"]
    Fork --> CR["<b>code-review-agent</b><br/><i>background</i><br/>CVSS + code evidence"]

    Team_SA2 -->|"03-05.md"| Team_SAV["<b>security-architect</b><br/><i>blocking · FRESH context</i><br/>Phases 6 + 8 — skeptical validation<br/><i>reads generative output from disk,<br/>so review does not inherit anchoring</i>"]
    Team_SAV -->|"06.md, 08.md, findings.json"| Team_DS2["<b>diagram-specialist</b><br/><i>blocking</i><br/>Phase 7 — risk overlay<br/>+ analytical visuals"]

    VS["<b>validation-specialist</b><br/><i>blocking · spawned by name</i><br/>Cross-validate every track, dedup,<br/>merge coverage.json <i>(single writer)</i>"]

    Team_DS2 -->|"07-final-diagram.md"| VS
    PA -->|"privacy-assessment.md"| VS
    GRC -->|"compliance-gap-analysis.md"| VS
    CR -->|"code-security-review.md"| VS

    VS -->|"validation-report.md"| Team_Gate{"Manifest Validation Gate<br/><i>deterministic</i>"}
    Team_Gate -->|"pass"| Team_RA["<b>report-analyst</b><br/><i>blocking</i><br/>QA + Consolidate +<br/>Generate 4 formats"]
    Team_RA --> Team_Done(["Team Complete<br/><b>report.html, .docx, .pdf, .pptx</b>"])
    Team_RA -.->|"if dashboard ∈ run-plan.outputs"| Dash

    %% ---------- Portfolio meta-view (opt-in, level ABOVE the per-product dashboard) ----------
    Dash -.->|"if chained (Step-0 opt-in)<br/>upsert run into portfolio.json"| Portfolio["<b>portfolio.html</b> — portfolio meta-view<br/><i>level above the per-product dashboard</i><br/>rolls up N member runs (worst-of posture,<br/>summed severity, assessed-weighted coverage,<br/>chain map, cross-product CWE/ATT&amp;CK/STRIDE)<br/>cards drill into each product's own dashboard.html"]

    %% ---------- Post ----------
    Solo_Done --> Verify["Parent verifies every file exists<br/>and is non-empty<br/><i>pipeline-summary.md</i>"]
    Team_Done --> Verify

    Note["<i>Every persona is spawned by its own <b>name</b> as subagent_type, via the <b>Agent</b> tool.<br/>Background spawns notify the parent on completion — there is no TaskOutput tool.</i>"]

    classDef start fill:#e0f2fe,stroke:#0284c7,stroke-width:2px,color:#0c4a6e
    classDef decision fill:#fef3c7,stroke:#f59e0b,stroke-width:2px,color:#78350f
    classDef agent fill:#f0fdf4,stroke:#22c55e,stroke-width:1.5px,color:#14532d
    classDef diagram fill:#e0f2fe,stroke:#0284c7,stroke-width:1.5px,color:#0c4a6e
    classDef done fill:#f0fdf4,stroke:#16a34a,stroke-width:2px,color:#14532d
    classDef control fill:#f3e8ff,stroke:#a855f7,stroke-width:1.5px,color:#581c87
    classDef fresh fill:#fee2e2,stroke:#ef4444,stroke-width:2px,color:#7f1d1d
    classDef note fill:#ffffff,stroke:#cbd5e1,stroke-width:1px,color:#475569

    class Start,Solo_Done,Team_Done,Verify start
    class Step0,Dash agent
    class Portfolio done
    class Mode,Solo_Gate,Team_Gate,Plan decision
    class Solo_SA1,Solo_SA2,Team_SA1,Team_SA2,PA,GRC,CR,Solo_RA,Team_RA agent
    class Solo_DS1,Solo_DS2,Team_DS1,Team_DS2 diagram
    class Fork,VS control
    class Solo_SAV,Team_SAV fresh
    class Note note
